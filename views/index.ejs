<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Book Notes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        Book Notes
      </a>
    </div>
  </nav>
  <div class="container hero text-center">
    <h1 class="display-4 fw-bold">
      Discover Your Next Favorite Book
    </h1>
    <p class="lead">
      Search books, write notes, and build your personal library.
    </p>
  </div>

  <div class="container mb-5">
    <form action="/" method="GET">
      <div class="input-group input-group-lg">
        <input class="form-control" type="text" name="q" placeholder="Search for books..." value="<%= query || '' %>">
        <button class="btn btn-primary">
          Search
        </button>
      </div>
    </form>
  </div>
  <div class="container">
    <div class="row">
      <% books.forEach(book=> { %>
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
          <div class="card book-card h-100">
            <% if (book.cover_i) { %>
              <img class="card-img-top" src="https://covers.openlibrary.org/b/id/<%= book.cover_i %>-L.jpg"
                alt="Book cover" width="150">
              <% } else { %>
                <img class="card-img-top" src="https://via.placeholder.com/300x450?text=No+Cover" alt="No Cover">
                <% } %>
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                      <%= book.title %>
                    </h5>
                    <p class="card-text">
                      <strong>Author:</strong>
                      <%= book.author_name ? book.author_name[0] : "Unknown" %>
                    </p>
                    <p class="card-text">
                      <strong>Published:</strong>
                      <%= book.first_publish_year || "N/A" %>
                    </p>
                    <div class="mt-auto">
                    <a href="/book/<%= book.key.split('/').pop() %>" class="btn btn-book">

                        View Details
                      </a>
                    </div>
                  </div>
          </div>
        </div>

        <% }) %>

    </div>

  </div>

</body>

</html>