<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= book.title %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                Book Notes
            </a>
        </div>
    </nav>

    <div class="container mt-5">

        <div class="row">

            <div class="col-md-4 text-center">

                <% if(book.covers && book.covers.length> 0){ %>

                    <img class="img-fluid rounded shadow"
                        src="https://covers.openlibrary.org/b/id/<%= book.covers[0] %>-L.jpg" alt="Book Cover">

                    <% } else { %>

                        <img class="img-fluid rounded shadow" src="https://via.placeholder.com/300x450?text=No+Cover">

                        <% } %>

            </div>

            <div class="col-md-8">

                <h1>
                    <%= book.title %>
                </h1>

                <% let description="No description available." ; if(book.description){ if(typeof
                    book.description==="string" ){ description=book.description; }else if(book.description.value){
                    description=book.description.value; } } %>

                    <p class="mt-3">
                        <%= description %>
                    </p>

                    <% if(book.subjects){ %>

                        <h4 class="mt-4">Subjects</h4>

                        <div class="mb-4">

                            <% book.subjects.slice(0,10).forEach(subject=> { %>

                                <span class="badge bg-secondary me-2 mb-2">
                                    <%= subject %>
                                </span>

                                <% }) %>

                        </div>

                        <% } %>

            </div>

        </div>

        <hr class="my-5">

        <h2>Add a Note</h2>

        <form action="/book/<%= workId %>/note" method="POST">

            <div class="mb-3">

                <label class="form-label">Rating</label>

                <select name="rating" class="form-select" required>
                    <option value="">Select Rating</option>
                    <option value="1">⭐</option>
                    <option value="2">⭐⭐</option>
                    <option value="3">⭐⭐⭐</option>
                    <option value="4">⭐⭐⭐⭐</option>
                    <option value="5">⭐⭐⭐⭐⭐</option>
                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">Your Note</label>

                <textarea class="form-control" name="note" rows="5" required></textarea>

            </div>

            <button class="btn btn-success">
                Save Note
            </button>

        </form>

        <hr class="my-5">

        <h2>My Notes</h2>

        <% if(notes.length===0){ %>

            <div class="alert alert-secondary">
                No notes added yet.
            </div>

            <% } else { %>

                <% notes.forEach(note=> { %>

                    <div class="card mb-3">

                        <div class="card-body">

                            <h5>
                                <%= "⭐" .repeat(note.rating) %>
                            </h5>

                            <p>
                                <%= note.note %>
                            </p>

                            <small class="text-muted">
                                <%= note.created_at %>
                            </small>

                            <div class="mt-3">

                                <a href="/note/edit/<%= note.note_id %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form action="/note/delete/<%= note.note_id %>" method="POST" style="display:inline;">

                                    <button class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                    <% }) %>

                        <% } %>

                            <a href="/" class="btn btn-secondary mt-4">
                                ← Back to Search
                            </a>

    </div>

</body>

</html>